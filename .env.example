# AQ Companies Logistics & Financial Management System
# Environment Configuration Template

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration
# For PostgreSQL (Docker / Production):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aq_companies?schema=public
# For SQLite (Local Development / Desktop / Testing):
# DATABASE_URL=file:./dev.db

# JWT & Authentication
JWT_SECRET=replace_this_with_a_secure_random_64_char_secret_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_this_with_another_secure_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4000,tauri://localhost

# Sensitive Data Encryption Key (for bank details at rest)
DATA_ENCRYPTION_KEY=32_byte_hex_key_for_aes_256_gcm_placeholder_here

# Storage Path for Uploads & Generated Documents
STORAGE_LOCAL_DIR=./storage_data

# Logging
LOG_LEVEL=info
