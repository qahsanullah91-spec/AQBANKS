{
  "version": 2,

  "framework": "vite",
  "installCommand": "rm -rf frontend/node_modules && npm --prefix frontend install --legacy-peer-deps",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
